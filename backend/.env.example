# ============================================================
# Paroisse Saint-Benoît — Variables d'environnement
# ============================================================
# Copiez ce fichier en ".env" et renseignez vos valeurs.
# Ne commitez JAMAIS le fichier .env dans git !

# Environnement ('development' ou 'production')
NODE_ENV=development

# Port du serveur (défaut : 3000)
PORT=3000

# Mot de passe du panneau d'administration (/admin)
# En production, choisissez un mot de passe fort et unique !
ADMIN_PASSWORD=changez-moi-par-un-mot-de-passe-tres-solide-2025

# Secret pour les sessions Express
# Générez-en un avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=remplacez-par-une-cle-secrete-aleatoire-longue

# Domaines autorisés pour CORS (séparés par des virgules en production)
# Exemple : CORS_ORIGIN=https://saint-benoit.cm,https://www.saint-benoit.cm
# En développement, laissez vide pour tout autoriser.
# CORS_ORIGIN=https://saint-benoit.cm
